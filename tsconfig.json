{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "vitest.config.ts", "vitest.arc.config.ts", "vitest.extension-engine.config.ts", "vitest.tabs.config.ts", "vitest.navigation.config.ts", "vitest.snapshot.config.ts", "vitest.interactions.config.ts", "vitest.page-tools.config.ts", "vitest.observability.config.ts", "vitest.reliability.config.ts", "vitest.release.config.ts", "vitest.soak.config.ts", "vitest.reconnect.config.ts"]
}
